{
  "mcpServers": {
    "kite": {
      "command": "/full/path/to/kite-mcp-server",
      "env": {
        "APP_MODE": "stdio",
        "KITE_API_KEY": "YOUR_KITE_CONNECT_API_KEY_TYPED_HERE_NEVER_IN_CHAT",
        "KITE_API_SECRET": "YOUR_KITE_CONNECT_API_SECRET_TYPED_HERE_NEVER_IN_CHAT",
        "EXCLUDED_TOOLS": "place_gtt_order,modify_gtt_order,delete_gtt_order"
      }
    },
    "kite-hosted": {
      "command": "npx",
      "args": ["mcp-remote", "https://mcp.kite.trade/mcp"]
    }
  }
}
